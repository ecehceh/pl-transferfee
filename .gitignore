data/*
!data/.gitkeep
# the scouting app reads this derived table; commit it so the app can deploy
# without the raw source data (the scout/ CSV stays out of git).
!data/scout_players.parquet
!data/scout_summary.json
# Generated outputs stay out of git, except the four small files the app
# reads -- committed so the app can be deployed without the raw data.
models/*
!models/.gitkeep
!models/transfers_scored.parquet
!models/metrics.json
!models/features.json
!models/seller_tier_effects.json
# Looker Studio CSVs: regenerated by src/export_looker.py, live in Google Sheets
exports/*
!exports/.gitkeep
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# machine-specific editor settings (launch.json is shared)
.vscode/settings.json
